# Скопируйте этот файл в .env и впишите свои значения.
# На Vercel те же переменные задаются в Settings → Environment Variables.

# Генерация визуализаций в блоке «Создай своё»
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Админка (admin.html): пароль входа
ADMIN_PASSWORD=

# Сохранение контента на боевом сайте: правки коммитятся в репозиторий,
# Vercel автоматически пересобирает сайт. Локально эти три переменные не нужны.
GITHUB_TOKEN=
GITHUB_REPO=логин/название-репозитория
GITHUB_BRANCH=main
